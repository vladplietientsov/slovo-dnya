# Скопіюй цей файл у .env і встав свій токен від @BotFather
TELEGRAM_BOT_TOKEN=

# секрет, від якого залежить слово дня (щоб його не вирахували з репо)
# згенеруй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=

# Telegram ID гравців через кому (бот покаже ID у відповідь на /start)
ALLOWED_USERS=

# часовий пояс
TIMEZONE=Europe/Kyiv

# база Turso для статистики (потрібна на Render; локально можна лишити порожнім —
# тоді все пишеться в data/game.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
